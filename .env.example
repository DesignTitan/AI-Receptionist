# ─────────────────────────────────────────────────────────────
# AI Receptionist — environment
# Copy to `.env.local` for local dev. Everything below is OPTIONAL:
# with no vars set the app boots in DEMO MODE (in-memory data,
# simulated voice calls, emails logged to the console).
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Public base URL. Required in production so the booking API can
# call its own webhook. On Vercel this is auto-derived from
# VERCEL_PROJECT_PRODUCTION_URL if you leave it blank.
# Business names live in src/verticals/*, not here.
# Single-tenant mode: set to a vertical slug on a CUSTOMER'S OWN deployment and
# that business renders at `/`; the product site and other demos disappear.
# Build-time (client bundles inline it). Leave empty on the product deployment.
NEXT_PUBLIC_TENANT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# One timezone shared by every demo business.
SITE_TIMEZONE=America/New_York

# ── Supabase ─────────────────────────────────────────────────
# Project settings → API. The service role key is server-only —
# never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site gate ────────────────────────────────────────────────
# public (default): product site + demos are open; /admin needs the staff
# password. locked: SITE_PASSWORD gates everything except provider webhooks.
SITE_GATE=public
# Only used when SITE_GATE=locked. Doubles as the signing secret for the
# gate cookie, so changing it signs everyone out. Default: "bubs2026".
SITE_PASSWORD=

# ── Admin dashboard ──────────────────────────────────────────
# Password for /admin. Demo default is "demo1234" — set this in prod.
ADMIN_PASSWORD=
# Random 32+ char string used to sign the admin session cookie.
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ── Voice AI ─────────────────────────────────────────────────
# vapi | bland | omnidimension | demo   (default: demo)
VOICE_PROVIDER=demo

# Ceiling on "have it call you" demo calls per day (default 50). The endpoint
# also rate-limits per address and per number and only dials +1 numbers.
TRY_CALL_DAILY_CAP=50

# Shared secret. Sent as `x-webhook-secret` on outbound dispatch and
# required on inbound provider callbacks at /api/webhooks/voice.
VOICE_WEBHOOK_SECRET=

# Vapi — https://dashboard.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Bland.ai — https://app.bland.ai
BLAND_API_KEY=
BLAND_VOICE_ID=
BLAND_PATHWAY_ID=

# OmniDimension — https://www.omnidim.io
OMNIDIMENSION_API_KEY=
OMNIDIMENSION_AGENT_ID=
# Optional: id of a number on your OmniDimension account to call from.
# Leave blank and the platform's default number rings. Set VOICE_WEBHOOK_SECRET
# too, and paste the URL from `docs/omnidimension.md` into the agent's Post-Call tab.
OMNIDIMENSION_FROM_NUMBER_ID=

# ── Human check (Cloudflare Turnstile) ───────────────────────
# Required before the homepage places a real call: a public form that dials
# numbers must never be reachable by a script. Free: dash.cloudflare.com →
# Turnstile → Add site (your domain) → copy both keys. Without these, a
# configured voice line is NOT used from the homepage (it takes a callback
# request instead). Cloudflare's test keys for local work:
#   site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# A number clients can call back (the agent reads it out on a reschedule).
CONTACT_PHONE=

# ── Email (Resend) ───────────────────────────────────────────
# https://resend.com/api-keys — leave blank to log emails instead.
RESEND_API_KEY=
EMAIL_FROM="AI Receptionist <frontdesk@yourbusiness.com>"
OWNER_EMAIL=owner@yourbusiness.com
# Shown as "Talk to us" on the product site. Falls back to OWNER_EMAIL; the
# button is left out entirely when neither is set.
CONTACT_EMAIL=
