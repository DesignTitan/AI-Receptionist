{
  "name": "ai-receptionist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/check-dev-tools-excluded.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && npm run build",
    "seed:sql": "node scripts/generate-seed-sql.ts",
    "test": "node --test tests/*.test.ts",
    "stripe:setup": "node --env-file-if-exists=.env.local scripts/setup-stripe.ts",
    "provision": "node --env-file-if-exists=.env.local scripts/provision.mjs",
    "ops": "node --env-file-if-exists=.env.local scripts/platform-ops.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup-platform.mjs",
    "dev:workspace": "node scripts/dev-workspace.mjs start",
    "dev:workspace:status": "node scripts/dev-workspace.mjs status",
    "dev:workspace:stop": "node scripts/dev-workspace.mjs stop"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@omnidim-ai/client": "^0.1.0",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
