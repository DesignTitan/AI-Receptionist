{
  "name": "ai-receptionist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && next build",
    "seed:sql": "node scripts/generate-seed-sql.ts",
    "test": "node --test tests/*.test.ts",
    "provision": "node --env-file-if-exists=.env.local scripts/provision.mjs",
    "ops": "node --env-file-if-exists=.env.local scripts/platform-ops.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup-platform.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "playwright-core": "^1.62.1"
  }
}
